<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:rep="http://www.softlinx.com/ReplixFax">
    <soapenv:Header/>
    <soapenv:Body>
        <rep:QueryReceiveFax>
            <QueryReceiveFaxInput>
                <!--Optional:-->
                <Authentication>
                    <Login>{login}</Login>
                    <Password>{password}</Password>
                    <Realm>acme</Realm>
                </Authentication>
                <!--Optional:-->
                <FaxId>{faxId}</FaxId>
                <!--Optional:-->
                <FaxUserId>{faxUserId}</FaxUserId>
            </QueryReceiveFaxInput>
        </rep:QueryReceiveFax>
    </soapenv:Body>
</soapenv:Envelope>